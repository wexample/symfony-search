{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form-field/form-field.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonySearchBundle.vue.form.fields.entity-search-input::*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonySearchBundle/vue/search/search-box') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/bar') -}}
{%- endblock -%}

{%- block field_control -%}
    <div class="entity-search-input" :class="{ 'entity-search-input--chips': multiple && search }">
        {#- The value the form submits. The box is a way of filling it, never
            what is posted. Several values are several inputs, as any
            multi-valued field posts — the name already ends in `[]`. -#}
        <template v-if="multiple">
            <input v-for="row in picked" :key="row.id" type="hidden" :name="name || null" :value="row.id">
        </template>
        <input v-else type="hidden" :name="name || null" :value="value">

        <div v-if="hasPicked" class="entity-search-input--picked-list">
            <bar
                    v-for="(row, index) in picked"
                    :key="row.id"
                    class="entity-search-input--picked"
                    :title="row.title"
                    :subtitle="row.subtitle"
                    :icon="row.icon || null"
            >
                <template #trailing>
                    <button
                            type="button"
                            class="button button--flat entity-search-input--clear"
                            :disabled="isDisabled ? true : null"
                            :aria-label="removeAriaLabel(row)"
                            @click="remove(index)"
                    >&times;</button>
                </template>
            </bar>
        </div>

        <search-box
                v-if="hasSearch"
                ref="searchBox"
                :input-id="resolvedId"
                :type="type"
                :context="context"
                :placeholder="placeholder"
                :link-results="false"
                @select="onSelect"
        ></search-box>
    </div>
{%- endblock -%}
