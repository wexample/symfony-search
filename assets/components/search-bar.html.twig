<div class="search-bar" data-context="{{ context | default('header') }}" data-length="{{ length | default(8) }}">
    <div class="search-bar--field">
        <span class="search-bar--icon" aria-hidden="true">{{ icon('ph:bold/magnifying-glass') }}</span>
        <input class="search-bar--input"
               type="search"
               autocomplete="off"
               role="combobox"
               aria-expanded="false"
               aria-autocomplete="list"
               placeholder="{{ placeholder is defined ? placeholder | trans : '@component::placeholder' | trans }}">
    </div>
    <div class="search-bar--dropdown" hidden>
        <ul class="search-bar--list" role="listbox"></ul>
        <p class="search-bar--empty" hidden>{{ '@component::empty' | trans }}</p>
        <p class="search-bar--pending" hidden>{{ '@component::pending' | trans }}</p>
    </div>
</div>
