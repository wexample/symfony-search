{
  "name": "wexample/symfony-search",
  "description": "Cross-cutting search for Symfony: entities, pages, and anything else worth finding",
  "type": "library",
  "license": "MIT",
  "version": "9.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonySearch\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-helpers": ">=8.1.0",
    "wexample/php-pseudocode": ">=3.1.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-api": ">=24.0.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "symfony/uid": ">=6.2",
    "symfony/routing": ">=6.2",
    "symfony/security-bundle": ">=6.2",
    "doctrine/orm": ">=2.14",
    "wexample/symfony-loader": ">=28.0.0",
    "wexample/symfony-design-system": ">=54.0.0",
    "wexample/symfony-content": ">=4.0.12",
    "wexample/symfony-forms": ">=19.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}