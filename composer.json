{
  "name": "wexample/symfony-search",
  "description": "Cross-cutting search for Symfony: entities, pages, and anything else worth finding",
  "type": "library",
  "license": "MIT",
  "version": "4.0.22",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySearch\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-helpers": ">=7.0.0",
    "wexample/php-pseudocode": ">=2.2.0",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-api": ">=11.0.0",
    "wexample/symfony-pseudocode": ">=3.0.0",
    "symfony/uid": ">=6.2",
    "symfony/routing": ">=6.2",
    "symfony/security-bundle": ">=6.2",
    "doctrine/orm": ">=2.14",
    "wexample/symfony-loader": ">=20.0.0",
    "wexample/symfony-design-system": ">=30.0.0",
    "wexample/symfony-content": ">=4.0.0",
    "wexample/symfony-forms": ">=10.0.0"
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}