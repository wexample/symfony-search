{
  "name": "wexample/symfony-search",
  "description": "Cross-cutting search for Symfony: entities, pages, and anything else worth finding",
  "type": "library",
  "license": "MIT",
  "version": "5.0.3",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySearch\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-helpers": ">=7.0.4",
    "wexample/php-pseudocode": ">=3.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-api": ">=16.0.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "symfony/uid": ">=6.2",
    "symfony/routing": ">=6.2",
    "symfony/security-bundle": ">=6.2",
    "doctrine/orm": ">=2.14",
    "wexample/symfony-loader": ">=25.3.0",
    "wexample/symfony-design-system": ">=40.0.0",
    "wexample/symfony-content": ">=4.0.12",
    "wexample/symfony-forms": ">=14.0.2"
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}